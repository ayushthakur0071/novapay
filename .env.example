# Flask Configurations
SECRET_KEY=your-very-long-random-secret-key-here-min-32-chars
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000

# Supabase Configurations
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_KEY=your-supabase-anon-key
DATABASE_URL=postgresql://postgres:password@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# Multi-Cloud Host Endpoints (Local simulation or Real-Time Cloud URLs)
# Local Simulation:
#   AWS_URL=http://localhost:5001
#   AZURE_URL=http://localhost:5002
# Real-Time Cloud Hosts (Example):
#   AWS_URL=https://novapay-aws.eu-west-1.awsapprunner.com
#   AZURE_URL=https://novapay-azure.azurewebsites.net
AWS_URL=http://localhost:5001
AZURE_URL=http://localhost:5002
PRIMARY_CLOUD=aws

# Cloud Regions
AWS_REGION=eu-west-1
AZURE_REGION=uk-south

# Disaster Recovery Parameters
FAILOVER_THRESHOLD_MS=3000
FAILOVER_FAILURE_COUNT=3
MONITOR_INTERVAL_SECONDS=30
HEALTH_CHECK_TIMEOUT=10

# Load Balancing Proxy Port & Timeouts
PROXY_PORT=8080
PROXY_TIMEOUT=30
BEHIND_PROXY=1
ENCRYPTION_KEY=your-32-byte-base64-encryption-key
